# Segredos apenas. O resto vai em legion.config.yaml.
# App principal (o do Cérebro); os outros bots usam este app se não tiverem o próprio.
# Nomes antigos DISCORD_TOKEN / DISCORD_CLIENT_ID ainda funcionam, mas troque para estes.
CEREBRO_TOKEN=
CEREBRO_CLIENT_ID=
DISCORD_GUILD_ID=
# Opcional: um app do Discord próprio para um bot (nome e avatar próprios).
# Defina os dois juntos; sem eles o bot usa o app do Cérebro. Veja docs/SELF_HOSTING.md.
# JARVIS_TOKEN=
# JARVIS_CLIENT_ID=
# Opcional; padrão file:./data/legion.db
DATABASE_URL=
LOG_LEVEL=info
HEALTH_PORT=8080
# Opcional, apenas texto de ULTRON
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
